APP_NAME="Nova Scholar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=nova_scholar
DB_USERNAME=nova_scholar
DB_PASSWORD=local-development-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@nova-scholar.test"
MAIL_FROM_NAME="${APP_NAME}"

# These variables prepare local object-storage development. S3 support will be
# enabled only after its Laravel filesystem dependency is approved and added.
AWS_ACCESS_KEY_ID=nova_scholar
AWS_SECRET_ACCESS_KEY=local-development-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=nova-scholar
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

TIKA_URL=http://127.0.0.1:9998
TIKA_TIMEOUT_SECONDS=90

OPENAI_API_KEY=
AI_DRIVER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

VITE_APP_NAME="${APP_NAME}"
